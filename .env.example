# LLM
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=            # open-weight model ID from OpenRouter
LLM_SAMPLES=5
LLM_TEMPERATURE=0.3
LLM_REASONING=off     # on | off (model thinking); off won on dev (B13)
LLM_CONCURRENCY=8     # parallel LLM requests

# Speech (GPU box)
ASR_MODEL=
ASR_SERVICE_URL=      # optional, see 05_BACKEND_STRUCTURE.md section 2
HF_TOKEN=

# App
DATA_DIR=./data
INBOX_DIR=./inbox
CASE_DATA_DIR=./case-data
PUBLIC_BASE_URL=http://localhost:5173
TRIGGER_API_URL=http://localhost:8080
TRIGGER_API_ENABLED=true
WATCHER_ENABLED=true  # start the inbox watcher with the API server
RETENTION_DAYS=30     # documented for production, not enforced in the demo
